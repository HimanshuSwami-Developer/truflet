# Copy to .env and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com

# PostgreSQL (leave unset to use SQLite while developing)
DATABASE_URL=postgres://turflet:turflet@localhost:5432/turflet

# Cloudinary — every uploaded image (venues, sports, offers, avatars) goes here when set
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=turflet

# Email sign-in codes. In dev mode every code is 123456 and the API returns it. Set False in production.
OTP_DEV_MODE=True
# SMTP for sending codes (leave EMAIL_HOST empty to print emails in the server console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Turflet <no-reply@yourdomain.com>

# Payments: "mock" confirms instantly. Add Razorpay/etc. in bookings/payments.py.
PAYMENT_PROVIDER=mock

PUBLIC_APP_URL=turflet.app
TIME_ZONE=Asia/Kolkata
